{
  "name": "neura-explainers",
  "private": true,
  "version": "1.0.0",
  "description": "نيورا — موقع زجاجي أنيق لشرح الذكاء الاصطناعي والبرمجة (عربي/إنجليزي)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview --host",
    "serve": "vite build && vite preview --host --open",
    "build:single": "vite build --config vite.single.config.js && node -e \"const fs=require('fs');fs.renameSync('standalone/index.html','standalone/neura.html')\""
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "vite": "^5.4.19",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
